  - m_Id: 41
    m_Localized: Mi sembra giusto
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: Non ne sono del tutto sicuro...
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Non lo vedo bene
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Sono d'accordo!\r"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "Whooly \xE8 tuo amico"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: Non hai fatto colpo su Whooly...
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Probabilmente...
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Non credo proprio...
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: Cosa stai dicendo!?
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Ovviamente!
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Roberto \xE8 tuo amico"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: Non hai fatto colpo su Roberto...
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: Bene...
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: Fai attenzione a quello che dici
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: Chiaro!
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Pilar \xE8 tuo amica"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Non hai fatto colpo su Pilar...
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: Certo, tesoro
    m_Metadata:
      m_Items: []
  - m_Id: 60
    m_Localized: Non lo so...
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: Hai esagerato!
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: Ne sono sicuro, tesoro!
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Lola \xE8 tuo amica"
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: Non hai fatto colpo su Lola...
    m_Metadata:
